{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discourse chart values",
  "type": "object",
  "properties": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "sidekiqWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadOnlyMany",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadOnlyMany",
                  "ReadWriteOncePod"
                ]
              }
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
