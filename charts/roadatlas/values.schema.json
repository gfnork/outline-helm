{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["hostname", "image", "runtime", "placeIndex", "postgresql"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "hostname": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string", "minLength": 1 } }
    },
    "placeIndex": {
      "type": "object",
      "required": ["hostRoot", "release"],
      "properties": {
        "hostRoot": { "type": "string", "pattern": "^/" },
        "release": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["image", "database", "username", "passwordKey", "persistence"],
      "properties": {
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}

